#include <stdio.h>

void fibonacci(int n) {
    long long int n1 = 0, n2 = 1, soma;
	int i = 1;
    
    printf("0 "); // Imprime o primeiro termo com um espaço
    
    while(i < n) {
        soma = n1 + n2;
        n1 = n2;
        n2 = soma;
        printf("%lld ", soma); // Imprime os próximos termos com espaço
        i++;
    }
    printf("\n"); // Pula uma linha ao final da sequência
}
int main(){
int numero;
printf("Digite a quantidade de termos da sequencia de fibonacci desejada: ");
scanf("%d", &numero);
if(numero <= 0){
	printf("A sequencia de Fibonacci só é válida para números naturais maiores que zero");
}
else{
fibonacci(numero);}}
